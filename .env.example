APP_ENV=local
TIMEZONE=Asia/Tokyo

LLM_PROVIDER=vllm
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=dummy
LLM_MODEL=etangaming123/KAngel

# Shared DB connection params (all services use the same credentials)
DB_HOST=db
DB_USERNAME=app_user
DB_PASSWORD=app_pass
DB_PORT=5432
DB_SSLMODE=disable

# Per-service DB names
APP_DB_NAME=app
CHECKPOINTER_DB_NAME=checkpointer
MLFLOW_DB_NAME=mlflow

# Atlas shadow database (used for schema diffing only)
DB_DEV_HOST=db_dev
APP_ATLAS_DEV_DB_NAME=app

# Upload LLM Model
HF_TOKEN=
HF_MODEL_ID=meta-llama/Llama-3.2-11B-Vision-Instruct
ML_DATA_BUCKET=aily-test-ml-data
CLOUDFRONT_URL=
