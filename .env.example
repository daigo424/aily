APP_ENV=local
API_BASE_URL=https://your-public-url.ngrok-free.app
LOCAL_PUBLISH_DOMAIN=your-public-url.ngrok-free.app
VERIFY_TOKEN=hello123
WHATSAPP_TOKEN=your_whatsapp_cloud_api_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_GRAPH_API_VERSION=v24.0
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
TIMEZONE=Asia/Tokyo

LLM_PROVIDER=vllm
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=dummy
LLM_MODEL=openbmb/minicpm-v2.6 # or qwen2.5vl:7b

# Shared DB connection params (all services use the same credentials)
DB_HOST=db
DB_USERNAME=app_user
DB_PASSWORD=app_pass
DB_PORT=5432
DB_SSLMODE=disable

# Per-service DB names
APP_DB_NAME=app
CP_CONVERSATION_DB_NAME=cp_conversation
MLFLOW_DB_NAME=mlflow

# Atlas shadow database (used for schema diffing only)
DB_DEV_HOST=db_dev
APP_ATLAS_DEV_DB_NAME=app
